# Kopie als .env.local anlegen und eigene Werte eintragen. Niemals echte Schluessel committen.

# Supabase-Projekt (Settings > API). Ohne beide Werte laeuft die App im lokalen Modus ohne Server.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Oeffentlicher (publishable) Schluessel, NICHT der service_role-Schluessel.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Anmeldemethoden: 1 = einschalten, sonst aus. Gast-Anmeldung ist immer moeglich.
VITE_AUTH_GOOGLE=0
VITE_AUTH_EMAIL=0
