{
  "name": "rumble-realms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "dev": "pnpm --filter @rumble-realms/web dev",
    "preview": "pnpm --filter @rumble-realms/web preview",
    "sim": "pnpm --silent --filter @rumble-realms/sim-cli start",
    "test:robust": "pnpm --silent --filter @rumble-realms/sim-cli start robust"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
